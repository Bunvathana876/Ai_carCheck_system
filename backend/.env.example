# Optional settings. Defaults work without a .env file.
# Copy to backend/.env to override them; restart the backend after changes.
PORT=3001
HOST=127.0.0.1
# Relative paths resolve from backend/, in development and production.
DATABASE_PATH=./data/voltguard.sqlite
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# No AI key is required. Never put private keys in VITE_* variables.

# Production frontend build, relative to backend/.
# FRONTEND_DIST=../frontend/dist
