{
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "name": "@voltguard/backend",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js --production",
    "lint": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "@voltguard/shared": "1.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "tsx": "^4.21.0",
    "@types/node": "^22.14.0",
    "@types/express": "^5.0.6"
  }
}
